MAX_UPLOAD_MB=10
MAX_ROWS=200000
MAX_COLUMNS=100
ALLOWED_ORIGINS=["http://localhost:3000"]
DEBUG=false

# --- AI -------------------------------------------------------------------
# Master switch for AI features. When false, no AI calls are made.
AI_ENABLED=true

# API key for the AI provider (OpenAI-compatible). Leave empty to run in local-only mode.
# NEVER commit the actual key. This key is server-side only.
AI_API_KEY=

# Base URL for any OpenAI-compatible chat completions endpoint.
# Examples: https://api.openai.com/v1 (OpenAI), https://api.groq.com/openai/v1 (Groq),
# https://openrouter.ai/api/v1 (OpenRouter), https://api.together.xyz/v1 (Together),
# https://generativelanguage.googleapis.com/v1beta/openai/ (Gemini OpenAI-compatible),
# http://localhost:11434/v1 (Ollama).
AI_BASE_URL=https://api.openai.com/v1

# Chat completion model name. Use a model your provider currently offers.
# This should match a model available at AI_BASE_URL.
AI_MODEL=gpt-4o-mini

# Per-request AI timeout in seconds.
AI_TIMEOUT_SECONDS=30.0

# Maximum tokens per AI response.
AI_MAX_TOKENS=1200

# Sampling temperature (0.0 - 1.0). Lower is more deterministic.
AI_TEMPERATURE=0.2

# Allow fallback to deterministic local analysis when no API key is configured
# or when the AI provider fails.
AI_ALLOW_LOCAL_FALLBACK=true

# Rate limit for AI endpoints only, per user/IP (in-process, per-instance).
# Value is requests per minute. Set to 0 to disable.
AI_RATE_LIMIT_PER_MINUTE=30
